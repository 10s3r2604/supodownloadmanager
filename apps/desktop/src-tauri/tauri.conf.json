{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supo Download Manager",
  "mainBinaryName": "sdm-desktop",
  "version": "0.7.4",
  "identifier": "com.supodownloadmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Supo Download Manager",
        "width": 880,
        "height": 560,
        "minWidth": 660,
        "minHeight": 420,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast, resumable, multi-connection downloads",
    "longDescription": "Supo Download Manager is a free and open-source download accelerator with pause and resume, a download queue, browser integration and a speed limiter.",
    "copyright": "Supo Download Manager contributors, GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "tools/": "tools/",
      "../../../extension/dist/chromium/": "extension/chromium/",
      "../../../extension/dist/firefox/": "extension/firefox/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwRkE2MTU1N0M5RkIxOEEKUldTS3NaOThWV0g2b05PbzNYdGxoeVlmVVRyOWNEWlFNVk43N2RGZGZUbktqdGJoUXBqZjJuSWYK",
      "endpoints": [
        "https://github.com/10s3r2604/supodownloadmanager/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
